{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsdown.config.ts"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "vitest.config.ts"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "@triplex-build/triplex-cli#test": {
      "dependsOn": ["build", "^build"],
      "inputs": ["src/**", "test/**", "package.json", "vitest.config.ts"],
      "outputs": []
    }
  }
}
