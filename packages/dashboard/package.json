{
  "name": "@triplex-build/triplex-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone Foldkit explorer for Triplex databases.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "vite --host 0.0.0.0 --port 4173",
    "serve": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@triplex-build/triplex": "workspace:^",
    "@triplex-build/triplex-postgres": "workspace:^",
    "@triplex-build/triplex-sqlite": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@foldkit/ui": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:peers",
    "@effect/platform-node": "catalog:peers",
    "@foldkit/ui": "catalog:peers",
    "effect": "catalog:peers",
    "foldkit": "catalog:peers"
  }
}
