{
  "name": "@triplex-build/triplex-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A React table explorer for Triplex databases: live tables, value history and audit trail.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "scripts": {
    "build": "vite build && tsdown",
    "build:playground": "vite build --config vite.playground.config.ts",
    "clean": "rm -rf dist dist-server",
    "dev": "vite --host 0.0.0.0 --port 4175",
    "serve": "tsx src/server/main.ts",
    "seed": "tsx src/seed/seed.ts",
    "activity": "tsx src/seed/activity.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@triplex-build/triplex-sqlite": "workspace:^",
    "@triplex-internal/core": "workspace:^",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
