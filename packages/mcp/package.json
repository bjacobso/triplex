{
  "name": "@triplex-build/triplex-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental stdio MCP tools for Triplex databases.",
  "bin": {
    "triplex-mcp": "./dist/bin.js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --rootDir src --outDir dist",
    "clean": "rm -rf dist",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@triplex-build/triplex-cli": "workspace:^",
    "@triplex-build/triplex-postgres": "workspace:^",
    "@triplex-build/triplex-sqlite": "workspace:^",
    "@triplex-internal/core": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "@effect/platform-node-shared": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
