{
  // Local development and tests. Production is defined in ../../alchemy.run.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triplex-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/mcp/"],
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "TriplexSession" }] },
  "migrations": [{ "tag": "mcp-sessions", "new_sqlite_classes": ["TriplexSession"] }],
  "ratelimits": [
    { "name": "MCP_CALLS", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
  ],
}
